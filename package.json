{
  "name": "here-to-slay-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present && npm run test:integration",
    "test:integration": "node --test --experimental-strip-types tests/*.test.ts tools/card-render/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "import-art": "node --experimental-strip-types tools/import-card-art.ts",
    "typecheck:tools": "tsc -p tools/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "sharp": "^0.35.5"
  }
}
